# ============================================================
# VulnFix — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# ============================================================

# --- Environnement ---
VULNFIX_ENV=development          # development | production

# --- Serveur Web ---
VULNFIX_HOST=127.0.0.1
VULNFIX_PORT=8505
VULNFIX_WORKERS=2                # Nombre de workers Gunicorn (production)

# --- Base de données ---
VULNFIX_DB_PATH=data/pentest.db

# --- Sécurité ---
VULNFIX_REQUIRE_AUTH=0           # 0 (dev) | 1 (production recommandé)
VULNFIX_CORS_ORIGINS=http://localhost:8505
SECRET_KEY=                    # OBLIGATOIRE en production (min. 32 chars)
JWT_EXPIRE_MINUTES=1440        # Durée token JWT (24h par défaut)

# --- Authentification admin ---
VULNFIX_ADMIN_USER=admin
VULNFIX_ADMIN_PASSWORD=admin       # Changer absolument en production

# --- LLM (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3            # Alternatives : mistral, phi3, etc.
OLLAMA_TIMEOUT=1800
OLLAMA_MAX_TOKENS=2048
OLLAMA_TEMPERATURE=0.1         # Basse pour limiter les hallucinations

# --- RAG (Recherche vectorielle FAISS) ---
RAG_KNOWLEDGE_DIR=data/knowledge_base
RAG_INDEX_PATH=data/faiss_index/pentest.index
RAG_CHUNKS_PATH=data/faiss_index/chunks.json
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_TOP_N_VULNS=10

# --- Cache Redis (optionnel, fallback mémoire si indisponible) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Journalisation ---
LOG_LEVEL=INFO
LOG_FILE=logs/vulnfix.log
