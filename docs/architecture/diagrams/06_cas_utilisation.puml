@startuml 06_cas_utilisation
title Diagramme de cas d'utilisation — SIATI
!include _theme.puml
left to right direction

skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #555555
}

actor "Pentester /\nAnalyste" as P
actor "Opérateur\nThreat Intelligence" as O

rectangle "SIATI" {

  ' ---- Objectifs métier principaux (visibles par l'utilisateur) ----
  usecase "Importer les\nrésultats de scan" as UC_IMPORT
  usecase "Exécuter une analyse\nde vulnérabilités" as UC_ANALYSE
  usecase "Consulter le\ntableau de bord" as UC_DASH
  usecase "Rechercher dans la\nbase de connaissances" as UC_KB
  usecase "Dialoguer avec\nl'assistant IA" as UC_CHAT
  usecase "Générer un playbook\nde remédiation" as UC_PLAYBOOK
  usecase "Générer un\nrapport" as UC_REPORT
  usecase "Consulter les\nperformances du modèle" as UC_PERF
  usecase "Supprimer\ndes données" as UC_DELETE
  usecase "Administrer\nle modèle" as UC_MODEL

  ' ---- Objectifs métier de l'opérateur Threat Intelligence ----
  usecase "Synchroniser les données\nde renseignement" as UC_SYNC
  usecase "Construire la base\nde renseignement" as UC_BUILD

  ' ---- Traitements internes (atteints uniquement par <<include>>) ----
  usecase "Enrichir les\nvulnérabilités" as UC_ENRICH
  usecase "Évaluer la\ncriticité" as UC_SCORE
  usecase "Générer les\nrecommandations" as UC_RECO
}

' ===== Associations acteur — Pentester / Analyste =====
P --> UC_IMPORT
P --> UC_ANALYSE
P --> UC_DASH
P --> UC_KB
P --> UC_CHAT
P --> UC_PLAYBOOK
P --> UC_REPORT
P --> UC_PERF
P --> UC_DELETE
P --> UC_MODEL

' ===== Associations acteur — Opérateur Threat Intelligence =====
O --> UC_SYNC
O --> UC_BUILD

' ===== Relations <<include>> (décomposition fonctionnelle) =====
UC_ANALYSE  ..> UC_IMPORT : <<include>>
UC_ANALYSE  ..> UC_ENRICH : <<include>>
UC_ANALYSE  ..> UC_SCORE  : <<include>>

UC_PLAYBOOK ..> UC_ENRICH : <<include>>
UC_PLAYBOOK ..> UC_SCORE  : <<include>>
UC_PLAYBOOK ..> UC_RECO   : <<include>>

UC_REPORT   ..> UC_SCORE  : <<include>>

' ===== Relation <<extend>> (comportement optionnel) =====
UC_PLAYBOOK <.. UC_CHAT : <<extend>>

@enduml
