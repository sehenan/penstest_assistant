' ============================================================
' Thème visuel partagé SIATI — à inclure dans chaque diagramme
' non-C4 via :  !include _theme.puml
' Objectif : rendu homogène, lisible et professionnel pour la
' soutenance (fond blanc, flèches orthogonales, espacement net).
' ============================================================
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam shadowing false
skinparam monochrome true
skinparam linetype ortho
skinparam nodesep 22
skinparam ranksep 48
skinparam componentStyle rectangle
skinparam roundCorner 8

skinparam ArrowColor #444444
skinparam ArrowFontSize 11
skinparam ArrowFontColor #333333

skinparam PackageBorderColor #888888
skinparam PackageFontStyle bold
skinparam PackageFontSize 13

skinparam RectangleBorderColor #555555
skinparam ComponentBorderColor #555555
skinparam DatabaseBorderColor #555555
